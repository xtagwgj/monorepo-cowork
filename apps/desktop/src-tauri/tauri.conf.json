{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cowork Desktop",
  "version": "0.1.0",
  "identifier": "com.cowork.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cowork Desktop",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cowork desktop shell",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
