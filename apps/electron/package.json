{
  "name": "@cowork/electron",
  "version": "0.0.0",
  "private": true,
  "description": "Cowork desktop demo application",
  "author": "cowork",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --config vite.renderer.config.ts --port 5175",
    "start": "pnpm build && electron .",
    "start:no-devtools": "pnpm build && ELECTRON_OPEN_DEVTOOLS=0 electron .",
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "echo \"skip lint for electron\"",
    "test": "vitest run",
    "pack": "pnpm build && electron-builder --dir --publish never",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "com.cowork.desktop",
    "productName": "Cowork Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "electronVersion": "35.0.0",
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
